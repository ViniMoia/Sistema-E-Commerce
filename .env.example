# ==============================================================================
# E-Commerce Multi-Tenant - Exemplo de Variáveis de Ambiente (.env.example)
# ATENÇÃO: NUNCA insira credenciais reais neste arquivo.
# Copie este arquivo para .env e preencha com os valores do seu ambiente.
# ==============================================================================

# Conexão com o Banco de Dados (PostgreSQL / Supabase Transaction Pooler)
DATABASE_URL="postgresql://postgres:sua_senha@seu_pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=10&pool_timeout=20"

# Conexão Direta para Migrations (Prisma Migrate / Direct Connection)
DIRECT_URL="postgresql://postgres:sua_senha@seu_host.supabase.com:5432/postgres?sslmode=require"

# Banco de Dados para Execução de Testes Automatizados (Obrigatório conter '_test' ou 'localhost')
TEST_DATABASE_URL="postgresql://postgres:sua_senha@localhost:5432/ecommerce_test"

# Segredo de Sessão e Criptografia
SESSION_SECRET="sua_chave_secreta_de_32_caracteres_minimo_aqui"
NEXTAUTH_SECRET="sua_chave_secreta_nextauth_aqui"

# Gateway de Pagamentos Asaas (PIX Dinâmico e Webhooks)
ASAAS_API_KEY="$aact_sua_chave_de_api_asaas_aqui"
ASAAS_API_URL="https://api.asaas.com/v3" # ou https://sandbox.asaas.com/api/v3 para homologação
ASAAS_WEBHOOK_TOKEN="seu_token_secreto_definido_no_webhook_asaas"

# Configurações de Multi-Tenancy & Domínio da Plataforma
PLATFORM_DOMAIN="continentalestetica.com.br"
NEXT_PUBLIC_DEFAULT_LOJA_SLUG="continental-prototipo"
NEXT_PUBLIC_LOJA_ID="id_da_loja_uuid_aqui"

# Configurações do Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Configurações Opcionais de Armazenamento / Storage
STORAGE_BUCKET_URL="https://seu_storage.exemplo.com"

# Supabase (Opcional - preencher apenas se utilizar Auth/Storage integrados)
NEXT_PUBLIC_SUPABASE_URL="https://seu_projeto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua_chave_anon_publica_aqui"
SUPABASE_SERVICE_ROLE_KEY="sua_chave_service_role_privada_aqui"

# E-mails Transacionais (Resend / Recuperação de Senha)
# Se não configurado, o sistema opera em modo de desenvolvimento (log local in-memory)
RESEND_API_KEY="re_sua_chave_de_api_resend_aqui"
EMAIL_FROM="Continental Produtos Estéticos <nao-responda@continentalestetica.com.br>"

# Segurança de Tarefas Agendadas (Cron de Timeout de Pedidos)
CRON_SECRET="sua_chave_secreta_aleatoria_para_execucao_do_cron"

