# ==============================================================================
# E-Commerce Multi-Tenant - Exemplo de Variáveis de Ambiente (.env.example)
# ATENÇÃO: NUNCA insira credenciais reais neste arquivo.
# Copie este arquivo para .env e preencha com os valores do seu ambiente.
# ==============================================================================

# Conexão com o Banco de Dados (PostgreSQL / Supabase Transaction Pooler)
DATABASE_URL="postgresql://postgres:sua_senha@seu_pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=10&pool_timeout=20"

# Conexão Direta para Migrations (Prisma Migrate / Direct Connection)
DIRECT_URL="postgresql://postgres:sua_senha@seu_host.supabase.com:5432/postgres?sslmode=require"

# Banco de Dados para Execução de Testes Automatizados (Obrigatório conter '_test' ou 'localhost')
TEST_DATABASE_URL="postgresql://postgres:sua_senha@localhost:5432/ecommerce_test"
TEST_BASE_URL="http://localhost:3000"
# Habilite somente ao executar o profiler Prisma em ambiente controlado.
PRISMA_QUERY_PROFILING="false"
# Smoke pós-deploy é read-only; destino remoto exige opt-in consciente.
SMOKE_BASE_URL="http://localhost:3000"
ALLOW_REMOTE_SMOKE="false"

# Ambiente funcional da aplicação. NODE_ENV é controlado pelo Next.js.
APP_ENV="development" # development | test | preview | staging | production
DEPLOYMENT_VERSION="git-sha-ou-digest-do-artefato"
# Obrigatória somente quando houver mais de uma instância com Server Actions.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="base64-de-chave-aes-compartilhada"

# Gateway de Pagamentos Asaas (PIX Dinâmico e Webhooks)
ASAAS_API_KEY="$aact_sua_chave_de_api_asaas_aqui"
ASAAS_API_URL="https://api.asaas.com/v3" # ou https://sandbox.asaas.com/api/v3 para homologação
ASAAS_WEBHOOK_TOKEN="seu_token_secreto_definido_no_webhook_asaas"
ASAAS_MIN_VALUE="5.00"
BOLETO_DUE_DAYS="1"
INSTALLMENT_ABSORB_FEES="false"
INSTALLMENT_MIN_VALUE="20.00"
INSTALLMENT_MAX_COUNT="12"
INSTALLMENT_MONTHLY_RATE="0.0299"

# Configurações de Multi-Tenancy & Domínio da Plataforma
PLATFORM_DOMAIN="continentalestetica.com.br"
NEXT_PUBLIC_DEFAULT_LOJA_SLUG="continental-prototipo"
DEFAULT_LOJA_SLUG="continental-prototipo"
NEXT_PUBLIC_LOJA_ID="id_da_loja_uuid_aqui"

# Proxy que sobrescreve o header de IP na borda: cloudflare, vercel ou generic.
# Deixe vazio até a topologia ser validada; nunca confie em X-Forwarded-For do cliente.
TRUSTED_PROXY_PROVIDER=""

# Configurações do Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Configurações Opcionais de Armazenamento / Storage
STORAGE_BUCKET_URL="https://seu_storage.exemplo.com"

# Supabase (Opcional - preencher apenas se utilizar Auth/Storage integrados)
NEXT_PUBLIC_SUPABASE_URL="https://seu_projeto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua_chave_anon_publica_aqui"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sua_chave_publicavel_aqui"
SUPABASE_SERVICE_ROLE_KEY="sua_chave_service_role_privada_aqui"

# E-mails Transacionais (Resend / Recuperação de Senha)
# Obrigatório em produção; sem chave o envio falha fechado. Em dev/test usa memória sem corpo em logs.
RESEND_API_KEY="re_sua_chave_de_api_resend_aqui"
EMAIL_FROM="Continental Produtos Estéticos <nao-responda@continentalestetica.com.br>"
EMAIL_PROVIDER_TIMEOUT_MS="8000"
READINESS_TIMEOUT_MS="2000"
OBSERVABILITY_TOKEN="substitua-por-token-operacional-aleatorio"

# Features privilegiadas (desabilitadas por padrão)
ENABLE_DIRECT_UPLOAD="false"
ENABLE_WEBHOOK_SIMULATOR="false"
NEXT_PUBLIC_ENABLE_WEBHOOK_SIMULATOR="false"

# Bootstrap administrativo exclusivamente local; não preencha nem versione valores reais.
ALLOW_ADMIN_BOOTSTRAP="false"
BOOTSTRAP_LOJA_ID=""
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME="Administrador local"

# Segurança de Tarefas Agendadas (Cron de Timeout de Pedidos)
CRON_SECRET="sua_chave_secreta_aleatoria_para_execucao_do_cron"
PAYMENT_RECONCILIATION_SLA_MINUTES="15"
REFUND_RECONCILIATION_SLA_MINUTES="30"

# Assinatura das cotações aceitas pelo checkout (mínimo 32 caracteres)
FREIGHT_QUOTE_SECRET="gere_uma_chave_aleatoria_com_32_ou_mais_caracteres"

# Teto técnico por intenção de ajuste manual de fidelidade (política deve ser homologada).
ADMIN_LOYALTY_MAX_ADJUSTMENT_POINTS="100000"


# Explicit opt-in for the standalone sandbox tool; keep disabled by default.
ALLOW_ASAAS_SANDBOX_WRITE=0
