# ==============================================================================
# E-Commerce Multi-Tenant - Exemplo de Variáveis de Ambiente (.env.example)
# ATENÇÃO: NUNCA insira credenciais reais neste arquivo.
# Copie este arquivo para .env e preencha com os valores do seu ambiente.
# ==============================================================================

# Conexão com o Banco de Dados (PostgreSQL / Supabase Transaction Pooler)
DATABASE_URL="postgresql://postgres:sua_senha@seu_pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=10&pool_timeout=20"

# Conexão Direta para Migrations (Prisma Migrate / Direct Connection)
DIRECT_URL="postgresql://postgres:sua_senha@seu_host.supabase.com:5432/postgres?sslmode=require"

# Banco descartável para testes automatizados (provisionado pelo executor)
# Não preencher manualmente: npm run test:integration:isolated provisiona
# TEST_DATABASE_URL, TEST_RUN_ID, TEST_BASE_URL e TEST_HTTP_TOKEN por execução.
# Testes não fazem fallback para DATABASE_URL nem aceitam um banco chamado apenas test.

# Segredo de Sessão e Criptografia
SESSION_SECRET="sua_chave_secreta_de_32_caracteres_minimo_aqui"
NEXTAUTH_SECRET="sua_chave_secreta_nextauth_aqui"

# Gateway de Pagamentos Asaas (PIX Dinâmico e Webhooks)
# Next.js expande $VAR; escape o dólar literal da chave com uma barra invertida.
ASAAS_API_KEY="\$aact_sua_chave_de_api_asaas_aqui"
ASAAS_API_URL="https://api.asaas.com/v3" # ou https://api-sandbox.asaas.com/v3 para homologação
ASAAS_WEBHOOK_TOKEN="seu_token_secreto_definido_no_webhook_asaas"
# Preview Vercel identificado (VERCEL=1 e VERCEL_ENV=preview) exige Sandbox,
# mesmo com NODE_ENV=production. Production e runtime otimizado fora de Preview
# continuam exigindo produção. Use banco separado e variáveis específicas de Preview.
# VERCEL/VERCEL_ENV são variáveis do sistema; não as forje no .env de produção.

# Configurações de Multi-Tenancy & Domínio da Plataforma
PLATFORM_DOMAIN="continentalestetica.com.br"
NEXT_PUBLIC_DEFAULT_LOJA_SLUG="continental-prototipo"
NEXT_PUBLIC_LOJA_ID="id_da_loja_uuid_aqui"

# Configurações do Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Configurações Opcionais de Armazenamento / Storage
STORAGE_BUCKET_URL="https://seu_storage.exemplo.com"

# Supabase (Opcional - preencher apenas se utilizar Auth/Storage integrados)
NEXT_PUBLIC_SUPABASE_URL="https://seu_projeto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua_chave_anon_publica_aqui"
SUPABASE_SERVICE_ROLE_KEY="sua_chave_service_role_privada_aqui"

# E-mails Transacionais (Resend / Recuperação de Senha)
# Se não configurado, o sistema opera em modo de desenvolvimento (log local in-memory)
RESEND_API_KEY="re_sua_chave_de_api_resend_aqui"
EMAIL_FROM="Continental Produtos Estéticos <nao-responda@continentalestetica.com.br>"

# Segurança de Tarefas Agendadas (Cron de Timeout de Pedidos)
CRON_SECRET="sua_chave_secreta_aleatoria_para_execucao_do_cron"

# Assinatura Criptográfica de Frete (Anti-Tampering HMAC-SHA256)
# WF-11/v2: substitua o exemplo por segredo aleatório privado >=32 caracteres,
# igual em todas as instâncias. Ausência em produção bloqueia cotações; rotação
# invalida tokens antigos e exige recotação. Não use o valor ilustrativo abaixo.
FREIGHT_QUOTE_SECRET="chave_secreta_minimo_32_caracteres_para_assinar_frete"

# Observabilidade Interna e Health Check
OBSERVABILITY_TOKEN="token_interno_para_consultar_metricas_e_health"

# WF-12: vendas remotas permanecem desabilitadas até WF-14/19/20.
# Exigem também flags explícitas na loja e credencial do ambiente correto.
# Ausência de chave/capacidade não converte cobrança em PIX manual.
PAYMENT_REMOTE_ENABLED="false"
# WF-14: activate only after migrations, supervised scheduler and sandbox gates.
PAYMENT_WORKER_ENABLED="false"
PAYMENT_EXPIRATION_ENABLED="false"
# Stable account identity; retain this scope when rotating the same account key.
ASAAS_ACCOUNT_SCOPE="primary"
ASAAS_ENABLED_LOJA_IDS=""
ASAAS_INSTALLMENTS_APPROVED="false"
# Parcelas: configuração privada validada e fornecida no DTO público de capacidade.
INSTALLMENT_ABSORB_FEES="false"
INSTALLMENT_MIN_VALUE="20"
INSTALLMENT_MAX_COUNT="12"
INSTALLMENT_MONTHLY_RATE="0.0299"
BOLETO_DUE_DAYS="1"
ASAAS_MIN_VALUE="5"
