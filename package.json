{
  "name": "ecommerce-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22.0.0 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "node scripts/start-runtime.mjs",
    "lint": "eslint . --max-warnings=16",
    "validate:env": "node scripts/validate-environment.mjs",
    "validate:env-contract": "node scripts/check-env-contract.mjs",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "db:up": "docker compose up -d postgres",
    "db:setup": "prisma migrate deploy && tsx --env-file=.env scripts/seed-local-dev.ts",
    "seed:local": "tsx --env-file=.env scripts/seed-local-dev.ts",
    "start:standalone": "node scripts/start-runtime.mjs",
    "smoke:deployment": "node scripts/smoke-deployment.mjs",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:integration:core": "vitest run tests/integration/database-invariants.test.ts tests/integration/transactions-invariants.test.ts tests/integration/backend-invariants.test.ts tests/integration/admin-invariants.test.ts tests/integration/query-profiler.test.ts tests/integration/test-db-isolation.test.ts tests/integration/payment-reconciliation-postgres.test.ts tests/integration/commerce-child-ownership.test.ts",
    "test:load": "vitest run tests/load",
    "test:sandbox:asaas-refund": "node --env-file=.env scripts/validate-asaas-refund-sandbox.mjs",
    "test:all": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toast": "^1.2.15",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "next": "^16.3.5",
    "prisma": "^5.22.0",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.75.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.5.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "nanoid": "^3.3.18",
    "postcss": "^8.5.26",
    "ws": "^8.21.3",
    "brace-expansion": "^1.1.18",
    "vite": "^8.2.1",
    "js-yaml": "^4.3.2",
    "browserslist": "^4.28.7",
    "postcss-selector-parser": "^6.1.3"
  }
}
