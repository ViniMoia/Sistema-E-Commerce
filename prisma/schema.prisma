// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Loja {
  id                   String    @id @default(uuid())
  name                 String
  slug                 String    @unique
  description          String
  coverImageUrl        String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User[]
  orders               Order[]
  products             Product[]
  brands               Brand[]
  categoryTags         CategoryTag[]
  primaryColor         String?   @default("#DDAF02")
  secondaryColor       String?   @default("#050505")
  customDomain         String?   @unique
  // PIX e WhatsApp configuration
  pixKey               String?   // Chave PIX (CPF, CNPJ, email, telefone ou aleatória)
  pixKeyType           String?   // Tipo: CPF, CNPJ, EMAIL, TELEFONE, ALEATORIA
  whatsappNumber       String?   // Número do WhatsApp para contato
  // Nuvemshop / ERP Integration configuration
  nuvemshopStoreId     String?
  nuvemshopAccessToken String?
  nuvemshopUserAgent   String?
  // Configurações de Frete e Expedição
  originCep            String?
  originState          String?
  originCity           String?
  originDistrict       String?
  originStreet         String?
  originNumber         String?
  originComplement     String?
  enableCorreios       Boolean   @default(false)
  correiosContractCode String?
  correiosPassword     String?
  enablePickup         Boolean   @default(true)
  enableNoFreight      Boolean   @default(true)
  additionalDays       Int       @default(0)
  // Configurações de Fidelidade / Pontos
  loyaltyEnabled          Boolean              @default(false)
  loyaltyEarnRate         Decimal              @default(0.5) @db.Decimal(5, 2)  // Multiplicador de ganho (0.5 = 1 pt a cada R$ 2)
  loyaltyPointValue       Decimal              @default(0.05) @db.Decimal(5, 4) // Conversão em R$ (0.05 = R$ 0,05 por ponto)
  loyaltyMinPointsRedeem  Int                  @default(100)                    // Saldo mínimo para permitir resgate
  loyaltyMaxDiscountPct   Decimal              @default(50.0) @db.Decimal(5, 2) // Limite de % de desconto no subtotal
  loyaltyPointsExpiryDays Int?                 @default(365)                    // Validade dos pontos em dias (ex: 365 dias)
  loyaltyWallets          LoyaltyWallet[]
  loyaltyTransactions     LoyaltyTransaction[]
}

model User {
  id                 String               @id @default(uuid())
  name               String               @db.VarChar(150)
  email              String               @db.VarChar(255)
  password           String               @db.VarChar(255)
  phone              String?              @db.VarChar(20)
  cpfCnpj            String?              @db.VarChar(20)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  avatarImageUrl     String?
  role               String               @default("CUSTOMER")
  emailVerified      DateTime?
  resetToken         String?
  resetTokenExpires  DateTime?
  status             UserStatus           @default(ACTIVE)
  lojaID             String
  loja               Loja                 @relation(fields: [lojaID], references: [id])
  products           Product[]
  addresses          Address[]
  carts              Cart[]
  defaultAddressId   String?              @unique
  defaultAddress     Address?             @relation("UserDefaultAddress", fields: [defaultAddressId], references: [id])
  sessions           Session[]
  orders             Order[]
  auditLogsAsTarget  AuditLog[]           @relation("AuditTarget")
  auditLogsAsActor   AuditLog[]           @relation("AuditActor")
  OrderStatusHistory OrderStatusHistory[]
  loyaltyWallets     LoyaltyWallet[]
  loyaltyTransactions LoyaltyTransaction[]

  @@unique([email, lojaID])
  @@index([email])
  @@index([lojaID])
  @@index([defaultAddressId])
  @@index([cpfCnpj])
  @@index([cpfCnpj, lojaID])
}

model Address {
  id             String   @id @default(uuid())
  cep            String
  state          String
  city           String
  district       String
  street         String
  number         String
  complement     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userID], references: [id])
  userID         String
  defaultForUser User?    @relation("UserDefaultAddress")
  orders         Order[]
  orderId        String?  @unique

  @@index([userID])
}

model Product {
  id                  String            @id @default(uuid())
  name                String
  description         String
  price               Decimal           @db.Decimal(10, 2)
  imageUrl            String
  galleryUrls         String[]          @default([])
  stock               Int
  sku                 String?
  nuvemshopProductId  String?
  stockBuffer         Int               @default(1)
  // Dimensões e Peso para Cálculo de Frete
  weightInGrams       Int?              @default(300)
  lengthCm            Int?              @default(16)
  widthCm             Int?              @default(11)
  heightCm            Int?              @default(4)
  freeShipping        Boolean           @default(false)
  lojaID              String
  loja                Loja              @relation(fields: [lojaID], references: [id], onDelete: Cascade)
  userID              String
  user                User              @relation(fields: [userID], references: [id], onDelete: Cascade)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  cartItem            CartItem[]
  productVariants     ProductVariants[]
  orderItems          OrderItem[]
  brandID             String?
  brand               Brand?            @relation(fields: [brandID], references: [id], onDelete: SetNull)
  categoryTags        ProductCategoryTag[]
  tagsSearchCache     String[]          @default([])

  @@index([lojaID])
  @@index([lojaID, sku])
  @@index([lojaID, brandID])
  @@index([nuvemshopProductId])
  @@index([createdAt])
}

model ProductVariants {
  id                 String      @id @default(uuid())
  ProductID          String
  product            Product     @relation(fields: [ProductID], references: [id], onDelete: Cascade)
  size               String
  color              String
  stock              Int
  sku                String?
  nuvemshopVariantId String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  cartItem           CartItem[]
  orderItems         OrderItem[]

  @@index([ProductID])
  @@index([sku])
  @@index([nuvemshopVariantId])
}

model Cart {
  id           String     @id @default(uuid())
  userID       String
  user         User       @relation(fields: [userID], references: [id], onDelete: Cascade)
  items        CartItem[]
  status       CartStatus @default(ACTIVE)
  shippingCost Float?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([userID])
  @@index([status])
}

model CartItem {
  id          String          @id @default(uuid())
  cartID      String
  cart        Cart            @relation(fields: [cartID], references: [id], onDelete: Cascade)
  productID   String
  product     Product         @relation(fields: [productID], references: [id], onDelete: Cascade)
  variantID   String
  variant     ProductVariants @relation(fields: [variantID], references: [id], onDelete: Cascade)
  quantity    Int
  productName String
  price       Decimal         @db.Decimal(10, 2)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  color       String
  size        String
  imageUrl    String

  @@unique([cartID, variantID])
}

enum CartStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum UserStatus {
  ACTIVE
  BLOCKED
  PENDING
}

enum Role {
  ADMIN
  CUSTOMER
  SELLER
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Order Management ────────────────────────────────────────────

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum SyncStatus {
  PENDING
  PROCESSING
  SYNCED
  FAILED
  DEAD_LETTER
}

enum DeliveryType {
  DELIVERY
  PICKUP
  NONE
}

model Order {
  id                 String               @id @default(uuid())
  orderNumber        Int                  @unique @default(autoincrement())
  userID             String
  user               User                 @relation(fields: [userID], references: [id])
  addressID          String?
  lojaID             String
  loja               Loja                 @relation(fields: [lojaID], references: [id])
  address            Address?             @relation(fields: [addressID], references: [id])
  status             OrderStatus          @default(PENDING)
  deliveryType       DeliveryType
  trackingCode       String?
  adminNotes         String?
  customerCpfCnpj    String?              @db.VarChar(20) // Snapshot histórico do documento do cliente no momento da compra
  paymentMethod      String?
  pixKeyUsed         String?              // Chave PIX usada no pagamento (para histórico)
  // Gateway Asaas fields
  asaasPaymentId        String?              @unique
  asaasPaymentStatus    String?              // ex: "PENDING", "RECEIVED", "CONFIRMED", "REFUNDED"
  asaasInvoiceUrl       String?              // Link da fatura/comprovante do Asaas
  // Campos de Cartão de Crédito e Boleto (Asaas Expansion)
  creditCardBrand       String?              // Bandeira: "VISA", "MASTERCARD", "ELO", etc.
  creditCardLast4       String?              // Últimos 4 dígitos: "1234"
  installments          Int?                 @default(1) // Número de parcelas
  installmentValue      Decimal?             @db.Decimal(10, 2) // Valor de cada parcela
  // Metadados de Boleto Bancário
  asaasBankSlipUrl      String?              // URL do PDF oficial do boleto
  asaasDigitableLine    String?              // Linha digitável (Cópia e Cola de 47/48 dígitos)
  asaasBarCode          String?              // Código de barras numérico
  asaasDueDate          DateTime?            // Data de vencimento efetiva
  // Confirmação de Entrega pelo Cliente
  deliveredConfirmedAt  DateTime?            // Data/hora da confirmação do recebimento pelo cliente
  deliveredConfirmedBy  String?              // ID do usuário cliente que confirmou
  freightValue       Decimal?
  subtotal           Decimal              @db.Decimal(10, 2)
  shippingCost       Decimal              @default(0) @db.Decimal(10, 2)
  shippingProvider   String?              // ex: "CORREIOS", "LOCAL_TABLE", "STORE_PICKUP", "NONE"
  shippingServiceName String?             // ex: "SEDEX", "PAC", "Retirada", "A Combinar"
  shippingEstimatedDays Int?              // Prazo prometido em dias úteis
  total              Decimal              @db.Decimal(10, 2)
  // Auditoria de Pontos no Pedido
  pointsEarned          Int                  @default(0) // Pontos previstos/gerados por este pedido
  pointsRedeemed        Int                  @default(0) // Pontos consumidos como desconto
  pointsDiscountValue   Decimal              @default(0) @db.Decimal(10, 2) // Valor monetário abatido em R$
  loyaltyTransactions   LoyaltyTransaction[]
  idempotencyKey        String?              @unique
  // Nuvemshop / ERP Sync fields
  nuvemshopOrderId   String?
  syncStatus         SyncStatus           @default(PENDING)
  syncAttempts       Int                  @default(0)
  lastSyncError      String?
  lastSyncedAt       DateTime?
  // Data de Liquidação / Pagamento Efetivo
  paidAt                DateTime?            // Data/hora em que o pagamento foi liquidado com sucesso
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  items              OrderItem[]
  statusHistory      OrderStatusHistory[]

  @@index([syncStatus])
  @@index([nuvemshopOrderId])
  @@index([lojaID])
  @@index([lojaID, status, createdAt])
  @@index([lojaID, status, paidAt])
  @@index([userID, createdAt])
  @@index([customerCpfCnpj])
}

model OrderItem {
  id                String           @id @default(uuid())
  orderId           String
  order             Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product?         @relation(fields: [productId], references: [id])
  name              String
  quantity          Int
  price             Decimal          @db.Decimal(10, 2)
  color             String?
  size              String?
  createdAt         DateTime         @default(now())
  variant           ProductVariants? @relation(fields: [productVariantsId], references: [id])
  productVariantsId String?

  @@index([orderId])
  @@index([productId])
  @@index([productVariantsId])
}

model OrderStatusHistory {
  id            String      @id @default(cuid())
  orderId       String
  order         Order       @relation(fields: [orderId], references: [id])
  status        OrderStatus
  performedById String
  performedBy   User        @relation(fields: [performedById], references: [id])
  ipAddress     String?
  createdAt     DateTime    @default(now())

  @@index([orderId])
}

model FreightRule {
  id        String   @id @default(cuid())
  lojaID    String
  cityName  String
  value     Decimal
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lojaID, cityName])
}

// ─── Audit & Synchronization Logging ─────────────────────────────

model AuditLog {
  id            String   @id @default(uuid())
  action        String
  targetId      String
  target        User     @relation("AuditTarget", fields: [targetId], references: [id])
  actorId       String
  actor         User     @relation("AuditActor", fields: [actorId], references: [id])
  entity        String
  entityId      String
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([targetId])
  @@index([actorId])
}

model StockSyncLog {
  id               String   @id @default(uuid())
  lojaID           String
  productId        String?
  variantId        String?
  sku              String?
  source           String   // "WEBHOOK", "CRON_RECONCILIATION", "ORDER_CHECKOUT", "MANUAL"
  previousStock    Int
  newStock         Int
  nuvemshopEventId String?
  metadata         Json?
  createdAt        DateTime @default(now())

  @@index([lojaID])
  @@index([sku])
  @@index([createdAt])
}

// ─── Loyalty & Points Engine ─────────────────────────────────────

enum LoyaltyTxType {
  EARN             // Pontos creditados por pedido concluído/pago
  REDEEM           // Pontos resgatados como desconto no checkout
  REFUND_EARN      // Estorno de pontos creditados (devido a cancelamento de pedido)
  REFUND_REDEEM    // Devolução de pontos resgatados (pedido cancelado)
  EXPIRATION       // Expiração periódica por decurso de prazo
  ADMIN_ADJUSTMENT // Ajuste manual realizado pelo administrador da loja
}

model LoyaltyWallet {
  id           String   @id @default(uuid())
  lojaID       String
  loja         Loja     @relation(fields: [lojaID], references: [id], onDelete: Cascade)
  userID       String
  user         User     @relation(fields: [userID], references: [id], onDelete: Cascade)
  
  balance      Int      @default(0) // Saldo disponível e confirmado para uso
  pending      Int      @default(0) // Pontos aguardando confirmação de pagamento
  lifetimeEarn Int      @default(0) // Histórico acumulado vitalício
  
  version      Int      @default(0) // Lock de concorrência / integridade
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([lojaID, userID])
  @@index([lojaID])
  @@index([userID])
}

model LoyaltyTransaction {
  id            String        @id @default(uuid())
  lojaID        String
  loja          Loja          @relation(fields: [lojaID], references: [id], onDelete: Cascade)
  userID        String
  user          User          @relation(fields: [userID], references: [id], onDelete: Cascade)
  orderId       String?
  order         Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  
  type          LoyaltyTxType
  points        Int           // Positivo para crédito (+500), negativo para débito (-500)
  balanceAfter  Int           // Saldo consolidado após esta operação
  monetaryValue Decimal?      @db.Decimal(10, 2) // Valor em R$ correspondente no momento da operação
  description   String
  expiresAt     DateTime?
  
  createdAt     DateTime      @default(now())

  @@index([lojaID, userID])
  @@index([orderId])
  @@index([createdAt])
}

// ─── Brands and Catalog Filters ──────────────────────────────────
model Brand {
  id          String    @id @default(uuid())
  name        String    @db.VarChar(100)
  slug        String    @db.VarChar(100)
  logoUrl     String?
  description String?   @db.Text
  websiteUrl  String?
  isActive    Boolean   @default(true)
  lojaID      String
  loja        Loja      @relation(fields: [lojaID], references: [id], onDelete: Cascade)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([lojaID, slug])
  @@index([lojaID])
  @@index([lojaID, isActive])
}

model CategoryTag {
  id          String               @id @default(uuid())
  name        String               @db.VarChar(80)
  slug        String               @db.VarChar(80)
  group       String               @default("GERAL")
  icon        String?
  order       Int                  @default(0)
  lojaID      String
  loja        Loja                 @relation(fields: [lojaID], references: [id], onDelete: Cascade)
  products    ProductCategoryTag[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([lojaID, slug])
  @@index([lojaID])
  @@index([lojaID, order])
}

model ProductCategoryTag {
  productID     String
  product       Product     @relation(fields: [productID], references: [id], onDelete: Cascade)
  categoryTagID String
  categoryTag   CategoryTag @relation(fields: [categoryTagID], references: [id], onDelete: Cascade)

  @@id([productID, categoryTagID])
  @@index([categoryTagID])
  @@index([productID])
}

// ─── Logística e Frete (J&T Express) ──────────────────────────────
model JtExpressGeocom {
  id           String   @id @default(uuid())
  state        String   @db.VarChar(2)
  cityPattern  String?
  cepStart     String   @db.VarChar(8)
  cepEnd       String   @db.VarChar(8)
  geocomCode   String
  deliveryDays Int      @default(3)
  isRiskZone   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([cepStart, cepEnd])
  @@index([geocomCode])
  @@index([state])
}

model JtExpressRate {
  id                String   @id @default(uuid())
  geocom            String
  macroRegion       String
  weightMin         Decimal  @db.Decimal(8, 3)
  weightMax         Decimal  @db.Decimal(8, 3)
  basePrice         Decimal  @db.Decimal(10, 2)
  additionalKgPrice Decimal? @db.Decimal(10, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([geocom, weightMin, weightMax])
  @@index([geocom])
  @@index([geocom, weightMin, weightMax])
}

model PaymentWebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  provider    String   // ex: "ASAAS"
  eventType   String   // ex: "PAYMENT_RECEIVED", "PAYMENT_CONFIRMED"
  payload     Json
  processedAt DateTime @default(now())

  @@index([provider, eventType])
  @@index([processedAt])
}

