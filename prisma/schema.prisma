// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Loja {
  id                   String    @id @default(uuid())
  name                 String
  slug                 String    @unique
  description          String
  coverImageUrl        String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User[]
  orders               Order[]
  products             Product[]
  brands               Brand[]
  categoryTags         CategoryTag[]
  primaryColor         String?   @default("#DDAF02")
  secondaryColor       String?   @default("#050505")
  customDomain         String?   @unique
  // PIX e WhatsApp configuration
  pixKey               String?   // Chave PIX (CPF, CNPJ, email, telefone ou aleatória)
  pixKeyType           String?   // Tipo: CPF, CNPJ, EMAIL, TELEFONE, ALEATORIA
  whatsappNumber       String?   // Número do WhatsApp para contato
  // Nuvemshop / ERP Integration configuration
  nuvemshopStoreId     String?
  nuvemshopAccessToken String?
  nuvemshopUserAgent   String?
  // Configurações de Frete e Expedição
  originCep            String?
  originState          String?
  originCity           String?
  originDistrict       String?
  originStreet         String?
  originNumber         String?
  originComplement     String?
  enableCorreios       Boolean   @default(false)
  correiosContractCode String?
  correiosPassword     String?
  enablePickup         Boolean   @default(true)
  enableNoFreight      Boolean   @default(true)
  additionalDays       Int       @default(0)
  // Configurações de Fidelidade / Pontos
  loyaltyEnabled          Boolean              @default(false)
  enableManualPix         Boolean              @default(false)
  enablePix               Boolean              @default(false)
  enableCreditCard        Boolean              @default(false)
  enableBoleto            Boolean              @default(false)
  loyaltyEarnRate         Decimal              @default(0.5) @db.Decimal(5, 2)  // Multiplicador de ganho (0.5 = 1 pt a cada R$ 2)
  loyaltyPointValue       Decimal              @default(0.05) @db.Decimal(5, 4) // Conversão em R$ (0.05 = R$ 0,05 por ponto)
  loyaltyMinPointsRedeem  Int                  @default(100)                    // Saldo mínimo para permitir resgate
  loyaltyMaxDiscountPct   Decimal              @default(50.0) @db.Decimal(5, 2) // Limite de % de desconto no subtotal
  loyaltyPointsExpiryDays Int?                 @default(365)                    // Validade dos pontos em dias (ex: 365 dias)
  loyaltyWallets          LoyaltyWallet[]
  loyaltyTransactions     LoyaltyTransaction[]
  checkoutIntents         CheckoutIntent[]
  checkoutBaskets         CheckoutBasket[]
  buyers                  OrderBuyer[]
  carts                   Cart[]
  freightQuotes           FreightQuote[]
  configurationVersion    Int                 @default(0)
}

model User {
  id                 String               @id @default(uuid())
  name               String               @db.VarChar(150)
  email              String               @db.VarChar(255)
  password           String               @db.VarChar(255)
  phone              String?              @db.VarChar(20)
  cpfCnpj            String?              @db.VarChar(20)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  avatarImageUrl     String?
  role               String               @default("CUSTOMER")
  emailVerified      DateTime?
  resetToken         String?
  resetTokenExpires  DateTime?
  status             UserStatus           @default(ACTIVE)
  lojaID             String
  loja               Loja                 @relation(fields: [lojaID], references: [id])
  products           Product[]
  addresses          Address[]
  carts              Cart[]
  defaultAddressId   String?              @unique
  defaultAddress     Address?             @relation("UserDefaultAddress", fields: [defaultAddressId], references: [id])
  sessions           Session[]
  orders             Order[]
  auditLogsAsTarget  AuditLog[]           @relation("AuditTarget")
  auditLogsAsActor   AuditLog[]           @relation("AuditActor")
  OrderStatusHistory OrderStatusHistory[]
  loyaltyWallets     LoyaltyWallet[]
  loyaltyTransactions LoyaltyTransaction[]
  checkoutIntents     CheckoutIntent[]
  buyers              OrderBuyer[]

  @@unique([email, lojaID])
  @@unique([id, lojaID])
  @@index([email])
  @@index([lojaID])
  @@index([defaultAddressId])
  @@index([cpfCnpj])
  @@index([cpfCnpj, lojaID])
  @@index([lojaID, status])
  @@index([lojaID, role])
  @@index([lojaID, resetToken])
}

model Address {
  id             String   @id @default(uuid())
  cep            String
  state          String
  city           String
  district       String
  street         String
  number         String
  complement     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userID], references: [id])
  userID         String
  defaultForUser User?    @relation("UserDefaultAddress")
  orders         Order[]
  orderId        String?  @unique

  @@index([userID])
  @@index([userID, createdAt])
}

model Product {
  id                  String            @id @default(uuid())
  name                String
  description         String
  price               Decimal           @db.Decimal(10, 2)
  imageUrl            String
  galleryUrls         String[]          @default([])
  stock               Int
  sku                 String?
  nuvemshopProductId  String?
  stockBuffer         Int               @default(1)
  // Dimensões e Peso para Cálculo de Frete
  weightInGrams       Int?              @default(300)
  lengthCm            Int?              @default(16)
  widthCm             Int?              @default(11)
  heightCm            Int?              @default(4)
  freeShipping        Boolean           @default(false)
  lojaID              String
  loja                Loja              @relation(fields: [lojaID], references: [id], onDelete: Cascade)
  userID              String
  user                User              @relation(fields: [userID], references: [id], onDelete: Cascade)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  cartItem            CartItem[]
  productVariants     ProductVariants[]
  orderItems          OrderItem[]
  brandID             String?
  brand               Brand?            @relation(fields: [brandID], references: [id], onDelete: SetNull)
  categoryTags        ProductCategoryTag[]
  tagsSearchCache     String[]          @default([])
  inventoryVersion   Int               @default(0)
  catalogVersion     Int               @default(0)
  unavailableStock   Int               @default(0)
  retiredAt          DateTime?
  reservations       InventoryReservation[]

  @@index([lojaID])
  @@index([lojaID, sku])
  @@index([lojaID, brandID])
  @@index([nuvemshopProductId])
  @@index([createdAt])
  @@index([lojaID, createdAt])
  @@index([lojaID, stock])
  @@unique([id, lojaID])
}

model ProductVariants {
  id                 String      @id @default(uuid())
  ProductID          String
  product            Product     @relation(fields: [ProductID], references: [id], onDelete: Cascade)
  size               String
  color              String
  stock              Int
  sku                String?
  nuvemshopVariantId String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  cartItem           CartItem[]
  orderItems         OrderItem[]
  inventoryVersion   Int                     @default(0)
  unavailableStock   Int                     @default(0)
  retiredAt          DateTime?
  reservations       InventoryReservation[]

  @@index([ProductID])
  @@unique([id, ProductID])
  @@index([sku])
  @@index([nuvemshopVariantId])
}

model Cart {
  // ACTIVE owner uniqueness uses the partial SQL index Cart_active_owner_key.
  id           String     @id @default(uuid())
  userID       String
  lojaID       String
  loja         Loja       @relation(fields: [lojaID], references: [id], onDelete: Restrict)
  user         User       @relation(fields: [userID, lojaID], references: [id, lojaID], onDelete: Cascade)
  items        CartItem[]
  status       CartStatus @default(ACTIVE)
  shippingCost Decimal?   @db.Decimal(10, 2)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  version      Int       @default(0)
  checkoutIntents CheckoutIntent[]
  consumedOrder  Order?

  @@index([userID])
  @@index([status])
  @@index([userID, status])
  @@index([lojaID, userID, status])
  @@unique([id, lojaID])
}

model CartItem {
  id          String          @id @default(uuid())
  cartID      String
  lojaID      String
  cart        Cart            @relation(fields: [cartID, lojaID], references: [id, lojaID], onDelete: Cascade)
  productID   String
  product     Product         @relation(fields: [productID, lojaID], references: [id, lojaID], onDelete: Cascade)
  variantID   String
  variant     ProductVariants @relation(fields: [variantID, productID], references: [id, ProductID], onDelete: Cascade)
  quantity    Int
  productName String
  price       Decimal         @db.Decimal(10, 2)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  color       String
  size        String
  imageUrl    String

  @@unique([cartID, variantID])
}

enum CartStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum UserStatus {
  ACTIVE
  BLOCKED
  PENDING
}

enum Role {
  ADMIN
  CUSTOMER
  SELLER
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Order Management ────────────────────────────────────────────

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum SyncStatus {
  PENDING
  PROCESSING
  SYNCED
  FAILED
  DEAD_LETTER
}

enum DeliveryType {
  DELIVERY
  PICKUP
  NONE
}

model Order {
  id                 String               @id @default(uuid())
  orderNumber        Int                  @unique @default(autoincrement())
  userID             String?
  user               User?                @relation(fields: [userID, lojaID], references: [id, lojaID], onDelete: Restrict)
  addressID          String?
  lojaID             String
  loja               Loja                 @relation(fields: [lojaID], references: [id])
  address            Address?             @relation(fields: [addressID], references: [id])
  status             OrderStatus          @default(PENDING)
  deliveryType       DeliveryType
  trackingCode       String?
  adminNotes         String?
  customerCpfCnpj    String?              @db.VarChar(20) // Snapshot histórico do documento do cliente no momento da compra
  paymentMethod      String?
  financialTotal     Decimal? @db.Decimal(10, 2)
  financingCharge    Decimal? @db.Decimal(10, 2)
  financialPlan      Json?
  loyaltyEarnSnapshot Json?
  pointsCredited     Int @default(0)
  pixKeyUsed         String?              // Chave PIX usada no pagamento (para histórico)
  // Gateway Asaas fields
  asaasPaymentId        String?              @unique
  asaasPaymentStatus    String?              // ex: "PENDING", "RECEIVED", "CONFIRMED", "REFUNDED"
  asaasInvoiceUrl       String?              // Link da fatura/comprovante do Asaas
  // Campos de Cartão de Crédito e Boleto (Asaas Expansion)
  creditCardBrand       String?              // Bandeira: "VISA", "MASTERCARD", "ELO", etc.
  creditCardLast4       String?              // Últimos 4 dígitos: "1234"
  installments          Int?                 @default(1) // Número de parcelas
  installmentValue      Decimal?             @db.Decimal(10, 2) // Valor de cada parcela
  // Metadados de Boleto Bancário
  asaasBankSlipUrl      String?              // URL do PDF oficial do boleto
  asaasDigitableLine    String?              // Linha digitável (Cópia e Cola de 47/48 dígitos)
  asaasBarCode          String?              // Código de barras numérico
  asaasDueDate          DateTime?            // Data de vencimento efetiva
  // Confirmação de Entrega pelo Cliente
  deliveredConfirmedAt  DateTime?            // Data/hora da confirmação do recebimento pelo cliente
  deliveredConfirmedBy  String?              // ID do usuário cliente que confirmou
  freightValue       Decimal?             @db.Decimal(10, 2)
  subtotal           Decimal              @db.Decimal(10, 2)
  shippingCost       Decimal              @default(0) @db.Decimal(10, 2)
  shippingProvider   String?              // ex: "CORREIOS", "LOCAL_TABLE", "STORE_PICKUP", "NONE"
  shippingServiceName String?             // ex: "SEDEX", "PAC", "Retirada", "A Combinar"
  shippingEstimatedDays Int?              // Prazo prometido em dias úteis
  freightQuoteId        String?
  freightSnapshot       Json?
  total              Decimal              @db.Decimal(10, 2)
  // Auditoria de Pontos no Pedido
  pointsEarned          Int                  @default(0) // Pontos previstos/gerados por este pedido
  pointsRedeemed        Int                  @default(0) // Pontos consumidos como desconto
  pointsDiscountValue   Decimal              @default(0) @db.Decimal(10, 2) // Valor monetário abatido em R$
  loyaltyTransactions   LoyaltyTransaction[]
  idempotencyKey        String?              @unique
  // Nuvemshop / ERP Sync fields
  nuvemshopOrderId   String?
  syncStatus         SyncStatus           @default(PENDING)
  syncAttempts       Int                  @default(0)
  lastSyncError      String?
  lastSyncedAt       DateTime?
  // Data de Liquidação / Pagamento Efetivo
  paidAt                DateTime?            // Data/hora em que o pagamento foi liquidado com sucesso
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  items              OrderItem[]
  statusHistory      OrderStatusHistory[]
  version            Int                    @default(0)
  buyerID            String?
  buyer              OrderBuyer?            @relation(fields: [buyerID, lojaID], references: [id, lojaID], onDelete: Restrict)
  checkoutIntentID   String?
  sourceCartID       String?                @unique
  sourceCart         Cart?                  @relation(fields: [sourceCartID, lojaID], references: [id, lojaID], onDelete: Restrict)
  checkoutIntent     CheckoutIntent?        @relation(fields: [checkoutIntentID, lojaID], references: [id, lojaID], onDelete: Restrict)
  financialSnapshot  Json?
  paymentAttempts    PaymentAttempt[]
  reservations       InventoryReservation[]
  financialFacts     FinancialFact[]

  @@index([syncStatus])
  @@index([nuvemshopOrderId])
  @@index([lojaID])
  @@index([lojaID, status, createdAt])
  @@index([lojaID, status, paidAt])
  @@index([userID, createdAt])
  @@index([customerCpfCnpj])
  @@index([lojaID, createdAt])
  @@index([lojaID, status])
  @@index([lojaID, userID])
  @@unique([checkoutIntentID, lojaID])
  @@unique([sourceCartID, lojaID])
}

model OrderItem {
  id                String           @id @default(uuid())
  orderId           String
  order             Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product?         @relation(fields: [productId], references: [id])
  name              String
  quantity          Int
  price             Decimal          @db.Decimal(10, 2)
  color             String?
  size              String?
  createdAt         DateTime         @default(now())
  variant           ProductVariants? @relation(fields: [productVariantsId], references: [id])
  productVariantsId String?
  reservation       InventoryReservation?

  @@index([orderId])
  @@index([productId])
  @@index([productVariantsId])
}

model OrderStatusHistory {
  id            String      @id @default(cuid())
  orderId       String
  order         Order       @relation(fields: [orderId], references: [id])
  status        OrderStatus
  performedById String?
  performedBy   User?       @relation(fields: [performedById], references: [id], onDelete: Restrict)
  actorType     CommerceActorType @default(USER)
  systemActor   String?
  commandKey    String?     @unique
  commandContentHash String? @db.VarChar(64)
  orderVersion  Int?
  previousStatus OrderStatus?
  ipAddress     String?
  createdAt     DateTime    @default(now())

  @@index([orderId])
  @@unique([orderId, orderVersion])
}

model FreightRule {
  id        String   @id @default(cuid())
  lojaID    String
  cityName  String
  state     String?  @db.VarChar(2)
  municipalityCode String? @db.VarChar(7)
  value     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lojaID, cityName])
}

// ─── Audit & Synchronization Logging ─────────────────────────────

model AuditLog {
  id            String   @id @default(uuid())
  action        String
  targetId      String?
  target        User?    @relation("AuditTarget", fields: [targetId], references: [id], onDelete: Restrict)
  actorId       String?
  actor         User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  actorType     CommerceActorType @default(USER)
  systemActor   String?
  effectKey     String?  @unique
  entity        String
  entityId      String
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([targetId])
  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model StockSyncLog {
  id               String   @id @default(uuid())
  lojaID           String
  productId        String?
  variantId        String?
  sku              String?
  source           String   // "WEBHOOK", "CRON_RECONCILIATION", "ORDER_CHECKOUT", "MANUAL"
  previousStock    Int
  newStock         Int
  nuvemshopEventId String?
  metadata         Json?
  createdAt        DateTime @default(now())

  @@index([lojaID])
  @@index([sku])
  @@index([createdAt])
}

// ─── Loyalty & Points Engine ─────────────────────────────────────

enum LoyaltyTxType {
  EARN             // Pontos creditados por pedido concluído/pago
  REDEEM           // Pontos resgatados como desconto no checkout
  REFUND_EARN      // Estorno de pontos creditados (devido a cancelamento de pedido)
  REFUND_REDEEM    // Devolução de pontos resgatados (pedido cancelado)
  EXPIRATION       // Expiração periódica por decurso de prazo
  ADMIN_ADJUSTMENT // Ajuste manual realizado pelo administrador da loja
}

model LoyaltyWallet {
  id           String   @id @default(uuid())
  lojaID       String
  loja         Loja     @relation(fields: [lojaID], references: [id], onDelete: Cascade)
  userID       String
  user         User     @relation(fields: [userID], references: [id], onDelete: Cascade)
  
  balance      Int      @default(0) // Saldo disponível e confirmado para uso
  pending      Int      @default(0) // Pontos aguardando confirmação de pagamento
  lifetimeEarn Int      @default(0) // Histórico acumulado vitalício
  
  version      Int      @default(0) // Lock de concorrência / integridade
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  debt         Int      @default(0)
  accountingReady Boolean @default(false) // Legados exigem conciliação explícita em WF-18
  expirationLeaseOwner String?
  expirationLeaseUntil DateTime?
  lots         LoyaltyLot[]

  @@unique([lojaID, userID])
  @@index([lojaID])
  @@index([userID])
}

model LoyaltyTransaction {
  id            String        @id @default(uuid())
  lojaID        String
  loja          Loja          @relation(fields: [lojaID], references: [id], onDelete: Cascade)
  userID        String
  user          User          @relation(fields: [userID], references: [id], onDelete: Cascade)
  orderId       String?
  order         Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  
  type          LoyaltyTxType
  points        Int           // Positivo para crédito (+500), negativo para débito (-500)
  balanceAfter  Int           // Saldo consolidado após esta operação
  monetaryValue Decimal?      @db.Decimal(10, 2) // Valor em R$ correspondente no momento da operação
  description   String
  expiresAt     DateTime?
  
  createdAt     DateTime      @default(now())
  effectKey     String?       @unique
  contentHash   String?
  availableDelta Int?
  debtDelta     Int?
  debtAfter     Int?
  policy        Json?
  lots          LoyaltyLot[]
  originatedLots LoyaltyLot[] @relation("LoyaltyOrigin")
  allocations   LoyaltyAllocation[]

  @@index([lojaID, userID])
  @@index([orderId])
  @@index([createdAt])
}

// ─── Brands and Catalog Filters ──────────────────────────────────
model Brand {
  id          String    @id @default(uuid())
  name        String    @db.VarChar(100)
  slug        String    @db.VarChar(100)
  logoUrl     String?
  description String?   @db.Text
  websiteUrl  String?
  isActive    Boolean   @default(true)
  lojaID      String
  loja        Loja      @relation(fields: [lojaID], references: [id], onDelete: Cascade)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([lojaID, slug])
  @@index([lojaID])
  @@index([lojaID, isActive])
}

model CategoryTag {
  id          String               @id @default(uuid())
  name        String               @db.VarChar(80)
  slug        String               @db.VarChar(80)
  group       String               @default("GERAL")
  icon        String?
  order       Int                  @default(0)
  lojaID      String
  loja        Loja                 @relation(fields: [lojaID], references: [id], onDelete: Cascade)
  products    ProductCategoryTag[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([lojaID, slug])
  @@index([lojaID])
  @@index([lojaID, order])
}

model ProductCategoryTag {
  productID     String
  product       Product     @relation(fields: [productID], references: [id], onDelete: Cascade)
  categoryTagID String
  categoryTag   CategoryTag @relation(fields: [categoryTagID], references: [id], onDelete: Cascade)

  @@id([productID, categoryTagID])
  @@index([categoryTagID])
  @@index([productID])
}

// ─── Logística e Frete (J&T Express) ──────────────────────────────
model JtExpressGeocom {
  id           String   @id @default(uuid())
  state        String   @db.VarChar(2)
  cityPattern  String?
  cepStart     String   @db.VarChar(8)
  cepEnd       String   @db.VarChar(8)
  geocomCode   String
  deliveryDays Int      @default(3)
  isRiskZone   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([cepStart, cepEnd])
  @@index([geocomCode])
  @@index([state])
}

model JtExpressRate {
  id                String   @id @default(uuid())
  geocom            String
  macroRegion       String
  weightMin         Decimal  @db.Decimal(8, 3)
  weightMax         Decimal  @db.Decimal(8, 3)
  basePrice         Decimal  @db.Decimal(10, 2)
  additionalKgPrice Decimal? @db.Decimal(10, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([geocom, weightMin, weightMax])
  @@index([geocom])
  @@index([geocom, weightMin, weightMax])
}

model PaymentWebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  provider    String   // ex: "ASAAS"
  eventType   String   // ex: "PAYMENT_RECEIVED", "PAYMENT_CONFIRMED"
  payload     Json
  processedAt DateTime @default(now())

  @@index([provider, eventType])
  @@index([processedAt])
}

// WF-04 expansion: legacy writers remain readable. These structures do not
// imply that legacy orders already have reservations, financial facts or lots.
enum CommerceActorType {
  USER
  SYSTEM
}

enum CheckoutIntentStatus {
  OPEN
  ACCEPTED
  PROCESSING
  COMPLETED
  REQUIRES_REVIEW
  CANCELLED
}

enum PaymentAttemptStatus {
  NOT_STARTED
  SUBMITTING
  UNKNOWN
  PENDING
  APPROVED
  DECLINED
  CANCEL_PENDING
  CANCELLED
  REFUND_PENDING
  REFUNDED
}

enum ReservationStatus {
  RESERVED
  COMMITTED
  RELEASED
  RETURNED
}

enum DurableWorkStatus {
  READY
  LEASED
  COMPLETED
  DEAD_LETTER
}

enum FinancialFactType {
  AUTHORIZED
  SETTLED
  REFUNDED
  CANCELLED
}

model OrderBuyer {
  id                String   @id @default(uuid())
  lojaID            String
  loja              Loja     @relation(fields: [lojaID], references: [id], onDelete: Restrict)
  authenticatedUserID String?
  authenticatedUser User?    @relation(fields: [authenticatedUserID, lojaID], references: [id, lojaID], onDelete: Restrict)
  name              String   @db.VarChar(150)
  email             String   @db.VarChar(255)
  phone             String?  @db.VarChar(20)
  cpfCnpj           String?  @db.VarChar(20)
  deliveryAddress   Json?
  billingAddress    Json?
  recoveryTokenHash String?  @unique
  recoveryExpiresAt DateTime?
  createdAt         DateTime @default(now())
  orders            Order[]
  checkoutIntents   CheckoutIntent[]

  @@index([lojaID, authenticatedUserID])
  @@unique([id, lojaID])
}

model CheckoutIntent {
  id             String               @id @default(uuid())
  lojaID         String
  loja           Loja                 @relation(fields: [lojaID], references: [id], onDelete: Restrict)
  ownerKey       String               @db.VarChar(128)
  userID         String?
  user           User?                @relation(fields: [userID, lojaID], references: [id, lojaID], onDelete: Restrict)
  buyerID        String?
  buyer          OrderBuyer?          @relation(fields: [buyerID, lojaID], references: [id, lojaID], onDelete: Restrict)
  key            String               @db.VarChar(128)
  cartID         String?
  cart           Cart?                @relation(fields: [cartID, lojaID], references: [id, lojaID], onDelete: Restrict)
  cartVersion    Int?
  basketID       String?
  basket         CheckoutBasket? @relation(fields: [basketID, lojaID], references: [id, lojaID], onDelete: Restrict)
  protocolVersion Int?
  revision       Int                  @default(0)
  contentHash    String               @db.VarChar(64)
  snapshot       Json
  status         CheckoutIntentStatus @default(OPEN)
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  order          Order?

  @@unique([lojaID, ownerKey, key])
  @@unique([id, lojaID])
  @@unique([cartID, cartVersion])
  @@unique([basketID])
  @@index([status, expiresAt])
}

// Guest purchase source. Completion never reopens it; another purchase requires
// an explicit request referencing the completed source and a known payment state.
model CheckoutBasket {
  id         String @id @default(uuid())
  lojaID     String
  loja       Loja @relation(fields: [lojaID], references: [id], onDelete: Restrict)
  ownerKey   String @db.VarChar(128)
  generation Int @default(0)
  status     CartStatus @default(ACTIVE)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  intents    CheckoutIntent[]

  @@unique([id, lojaID])
  @@unique([lojaID, ownerKey, generation])
  @@index([lojaID, ownerKey, createdAt])
}

model PaymentAttempt {
  id                String               @id @default(uuid())
  orderId           String
  order             Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  number            Int
  provider          String               @db.VarChar(32)
  providerAccount   String?              @db.VarChar(24)
  method            String               @db.VarChar(32)
  status            PaymentAttemptStatus @default(NOT_STARTED)
  externalReference String               @unique @db.VarChar(128)
  providerContractId String?
  financialTotal    Decimal              @db.Decimal(10, 2)
  installments      Int                  @default(1)
  planSnapshot      Json
  version           Int                  @default(0)
  submittedAt       DateTime?
  externalExpiresAt DateTime?
  reconcileAfter    DateTime?
  failureCode       String?              @db.VarChar(96)
  leaseOwner        String?
  leaseExpiresAt    DateTime?
  reconcileAttempts Int                  @default(0)
  reservationExpiresAt DateTime?
  reviewAfter       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  charges           PaymentCharge[]
  financialFacts    FinancialFact[]

  operations        PaymentOperation[]

  @@unique([orderId, number])
  @@index([status, reconcileAfter])
}

model PaymentCharge {
  id                String         @id @default(uuid())
  attemptId         String
  attempt           PaymentAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  provider          String         @db.VarChar(32)
  providerAccount   String?        @db.VarChar(24)
  providerPaymentId String
  ordinal           Int
  amount            Decimal        @db.Decimal(10, 2)
  providerStatus    String         @db.VarChar(64)
  dueAt             DateTime?
  settledAt         DateTime?
  instructions      Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  financialFacts    FinancialFact[]
  operations        PaymentOperation[]

  @@unique([provider, providerPaymentId])
  @@unique([attemptId, ordinal])
}

model FinancialFact {
  id             String            @id @default(uuid())
  orderId        String
  order          Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  attemptId      String?
  attempt        PaymentAttempt?   @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  chargeId       String?
  charge         PaymentCharge?    @relation(fields: [chargeId], references: [id], onDelete: Restrict)
  provider       String            @db.VarChar(32)
  providerAccount String?          @db.VarChar(24)
  factKey        String            @db.VarChar(160)
  type           FinancialFactType
  amount         Decimal           @db.Decimal(10, 2)
  occurredAt     DateTime
  createdAt      DateTime          @default(now())

  @@unique([provider, factKey])
  @@index([orderId, type, occurredAt])
}

// Full-charge operations only. A possibly submitted operation is reconciled,
// never submitted again solely because a lease or HTTP response was lost.
model PaymentOperation {
  id             String @id @default(uuid())
  attemptId      String
  attempt        PaymentAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  chargeId       String
  charge         PaymentCharge @relation(fields: [chargeId], references: [id], onDelete: Restrict)
  kind           String @db.VarChar(16)
  commandKey     String @db.VarChar(64)
  status         String @default("READY") @db.VarChar(16)
  requestedById  String? @db.VarChar(128)
  createdAt      DateTime @default(now())
  submittedAt    DateTime?
  completedAt    DateTime?
  lastErrorCode  String? @db.VarChar(96)

  @@unique([chargeId, kind])
  @@index([attemptId, status])
}

model InventoryReservation {
  id             String            @id @default(uuid())
  orderId        String
  order          Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItemId    String            @unique
  orderItem      OrderItem         @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  productId      String
  product        Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId      String
  variant        ProductVariants   @relation(fields: [variantId, productId], references: [id, ProductID], onDelete: Restrict)
  quantity       Int
  status         ReservationStatus @default(RESERVED)
  version        Int               @default(0)
  expiresAt      DateTime?
  releasedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status, expiresAt])
  @@index([productId, variantId])
}

model LoyaltyLot {
  id                   String             @id @default(uuid())
  walletId             String
  wallet               LoyaltyWallet      @relation(fields: [walletId], references: [id], onDelete: Restrict)
  sourceTransactionId  String
  sourceTransaction    LoyaltyTransaction @relation(fields: [sourceTransactionId], references: [id], onDelete: Restrict)
  originTransactionId  String?
  originTransaction    LoyaltyTransaction? @relation("LoyaltyOrigin", fields: [originTransactionId], references: [id], onDelete: Restrict)
  sourceKey            String             @db.VarChar(128)
  sourceAllocationId   String?
  sourceAllocation     LoyaltyAllocation? @relation("RestoredAllocation", fields: [sourceAllocationId], references: [id], onDelete: Restrict)
  credited             Int
  remaining            Int
  expiresAt            DateTime?
  createdAt            DateTime           @default(now())
  allocations          LoyaltyAllocation[] @relation("AllocatedLot")

  @@unique([sourceTransactionId, sourceKey])
  @@index([walletId, expiresAt, createdAt])
  @@index([originTransactionId])
}

model LoyaltyAllocation {
  id            String             @id @default(uuid())
  lotId         String
  lot           LoyaltyLot         @relation("AllocatedLot", fields: [lotId], references: [id], onDelete: Restrict)
  transactionId String
  transaction   LoyaltyTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  points        Int
  createdAt     DateTime           @default(now())
  restoredLots  LoyaltyLot[]       @relation("RestoredAllocation")

  @@unique([transactionId, lotId])
}

model PaymentInbox {
  id            String            @id @default(uuid())
  provider      String            @db.VarChar(32)
  eventId       String            @db.VarChar(160)
  eventType     String            @db.VarChar(64)
  payload       Json
  status        DurableWorkStatus @default(READY)
  attempts      Int               @default(0)
  leaseOwner    String?
  leaseExpiresAt DateTime?
  nextAttemptAt DateTime          @default(now())
  lastErrorCode String?           @db.VarChar(96)
  receivedAt    DateTime          @default(now())
  completedAt   DateTime?

  @@unique([provider, eventId])
  @@index([status, nextAttemptAt, leaseExpiresAt])
}

model CommerceOutbox {
  id             String            @id @default(uuid())
  effectKey      String            @unique @db.VarChar(160)
  commandType    String            @db.VarChar(64)
  aggregateId    String
  payload        Json
  status         DurableWorkStatus @default(READY)
  attempts       Int               @default(0)
  leaseOwner     String?
  leaseExpiresAt DateTime?
  nextAttemptAt  DateTime          @default(now())
  lastErrorCode  String?           @db.VarChar(96)
  createdAt      DateTime          @default(now())
  completedAt    DateTime?

  @@index([status, nextAttemptAt, leaseExpiresAt])
  @@index([aggregateId, commandType])
}

model FreightQuote {
  id                   String   @id @default(uuid())
  lojaID               String
  loja                 Loja     @relation(fields: [lojaID], references: [id], onDelete: Restrict)
  ownerKey             String   @db.VarChar(128)
  cartContentHash      String   @db.VarChar(64)
  destinationHash      String   @db.VarChar(64)
  configurationVersion Int
  fingerprint          String?  @db.VarChar(64)
  serviceCode          String?  @db.VarChar(120)
  snapshot             Json?
  deliveryType         DeliveryType
  provider             String   @db.VarChar(32)
  serviceName          String   @db.VarChar(120)
  amount               Decimal  @db.Decimal(10, 2)
  estimatedDays        Int
  expiresAt            DateTime
  createdAt            DateTime @default(now())

  @@index([lojaID, expiresAt])
}

model FreightTariffRevision {
  id        String @id @db.VarChar(32)
  version   Int    @default(0)
}

